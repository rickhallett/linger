---
import '../styles/site.css';
import '../styles/journey.css';
import Project from '../components/JourneyProject.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="A terminal app for reading Claude Code and Codex sessions. Inspect the commands, look up unfamiliar parts, and keep a field guide of what you learn."/><link rel="canonical" href={new URL('/', Astro.site)}/><title>Linger — go back, look closer</title><link rel="icon" href="/favicon.svg"/><noscript><style>.journey-scroll{display:none}.journey-project{opacity:1;margin-top:0;pointer-events:auto}.journey-nav{color:#263c33}</style></noscript></head>
<body class="journey-page">
<header class="journey-nav"><a class="journey-brand" href="/">[ linger ]</a><nav aria-label="Main navigation"><a href="#project-main" id="skip-journey">Skip to Linger</a></nav></header>
<div class="landing-phosphor" aria-hidden="true"><div><img src="/backgrounds/phosphor.png" alt=""/><img src="/backgrounds/phosphor.png" alt=""/></div></div>
<section class="journey-scroll" aria-label="From a session to a command">
  <div class="journey-viewport">
    <div class="green-curtains" aria-hidden="true"><div></div><div></div></div>
    <div id="journey-three" aria-hidden="true"></div><div id="journey-pixels" aria-hidden="true"></div>
    <div class="journey-copy time-copy"><h1>Go back.<br/>Look closer.</h1><p>The run moves on. You can stay with the part you want to understand.</p></div>
    <div class="journey-copy matter-copy" inert><h2>Read it, piece<br/>by piece.</h2><p>A command becomes less mysterious when you can point to the part you don’t understand.</p></div>
    <div class="travel-cue"><span>Scroll through the session</span><div aria-hidden="true"><i></i></div></div>
    <div class="journey-anatomy" inert>
      <div class="journey-parts" role="group" aria-label="Select a syntax part"><button data-syntax="0" aria-pressed="false">sed</button><button data-syntax="1" aria-pressed="true">-n</button><button data-syntax="2" aria-pressed="false">'8,16p'</button><button data-syntax="3" aria-pressed="false">src/main.py</button></div>
      <div class="journey-definition" aria-live="polite"><h3 id="syntax-name">-n</h3><p id="syntax-description">Turn off automatic printing. Let the expression decide which lines appear.</p></div>
    </div>
    <div class="journey-status" role="status"></div>
  </div>
</section>
<div class="journey-project"><Project/></div>
<script>import { startJourney } from '../scripts/journey';startJourney();</script>
</body></html>
