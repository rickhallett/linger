---
import '../styles/site.css';
import lines from '../../../examples/repair.jsonl?raw';
const records = lines.trim().split('\n').map(line => JSON.parse(line));
const notes = [
  'rg searches file contents. -n includes line numbers. TODO is the search pattern; src is the directory being searched.',
  "sed -n suppresses automatic printing. '8,16p' prints lines 8 through 16 of src/main.py.",
  'python3 - reads a program from standard input. The quoted heredoc delimiter keeps the shell from expanding the embedded Python. The Python body is code, not shell syntax.',
  'git status reports working-tree state. --short uses a compact format; --branch adds branch information.',
];
const calls = records.filter(r => r.payload?.type === 'function_call').map((r, index) => {
  const input = JSON.parse(r.payload.arguments);
  const result = records.find(x => x.payload?.type === 'function_call_output' && x.payload.call_id === r.payload.call_id);
  const output = result ? JSON.parse(result.payload.output) : null;
  return { input: input.cmd, output: output?.output ?? 'No output recorded.', exit: output?.exit_code, time: r.timestamp.slice(11,19), resultTime: result?.timestamp.slice(11,19), note: notes[index] ?? 'No reference note available.' };
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Linger — Make sense of the run.</title>
  <meta name="description" content="Watch Claude Code and Codex sessions in your terminal. Rewind a run, inspect recorded tool calls, and understand what happened with Linger." />
  <meta name="theme-color" content="#32473B" />
  <meta property="og:title" content="Linger — Make sense of the run." />
  <meta property="og:description" content="A closer look at your agents’ work. Follow live, move through time, and inspect the evidence." />
  <meta property="og:type" content="website" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="shell nav"><a class="wordmark" href="/" aria-label="Linger home"><span class="logo-bracket" aria-hidden="true">[</span>linger<span class="logo-bracket" aria-hidden="true">]</span></a><nav aria-label="Main navigation"><a href="#explore">Explore</a><a href="/guide/">Guide</a><a class="nav-build" href="#install">Install <span aria-hidden="true">↗</span></a></nav></header>
<main id="main">
<div class="opening">
<section class="shell hero">
  <h1>The agent ran it.<br />Now make sense of it.</h1>
  <div class="intro"><p class="body-copy">A terminal companion for the part after “what happened?” Follow your agents, revisit their calls, and read the evidence at your own pace.</p><a class="primary" href="#explore">Take a closer look <span aria-hidden="true">↗</span></a><p class="availability">For Claude Code &amp; Codex. MIT licensed.</p></div>
</section>
<section id="explore" class="shell demo-section" aria-label="Interactive Linger demonstration">
 <div class="demo-caption"><p>Inside a four-call session</p><span>Fictional, interactive illustration</span></div>
 <div class="terminal" id="inspector">
  <div class="terminal-top"><span class="terminal-brand">Session inspector</span><span>repair.jsonl</span><span class="session-status">Replay</span></div>
  <div class="transport"><button id="previous" aria-label="Previous recorded call">‹</button><div class="timeline" aria-label="Recorded call timeline">{calls.map((_,i)=><button data-event={i} class:list={{current:i===2}} aria-label={`Jump to call ${i+1}`} aria-pressed={i===2}><span></span></button>)}</div><button id="next" aria-label="Next recorded call">›</button><span id="position">03 / 04</span></div>
  <div class="inspector-grid">
   <div class="calls"><div class="pane-title">Tool calls <span>{calls.length} recorded</span></div><div class="call-list" role="group" aria-label="Select a recorded tool call">{calls.map((call,i)=><button class:list={['call',{'selected':i===2}]} data-call={i} aria-pressed={i===2}><span class:list={['result',{'failed':call.exit!==0}]}>{call.exit===0?'✓':'×'}</span><span class="call-name">{call.input.split('\n')[0]}<small>{call.time} · exec_command</small></span><span class="call-arrow" aria-hidden="true">›</span></button>)}</div><p class="call-hint">Select a call to read its evidence.<br /><kbd>↑</kbd> <kbd>↓</kbd> move between calls</p></div>
   <div class="evidence"><div class="pane-title"><span id="evidence-title">python3</span><span id="exit-status" class="failed">Exit 1</span></div><div class="evidence-tabs" role="group" aria-label="Evidence view"><button data-view="input" aria-pressed="false">Input</button><button data-view="output" class="active" aria-pressed="true">Recorded output</button><button data-view="note" aria-pressed="false">Reference</button></div><div class="evidence-content" role="region" aria-label="Selected evidence" tabindex="0"><p id="evidence-label">Recorded at 10:00:20</p><pre id="evidence-text">{calls[2].output}</pre><p id="evidence-foot">The command failed. The recorded error stays visible.</p></div></div>
  </div>
 </div>
 <div class="under-demo"><p>Your reading pace. Your next question.</p><span>This illustration runs locally in your browser. No commands or model requests run.</span></div>
 <noscript><p>Enable JavaScript to switch calls and evidence views. The fictional Python failure is shown above.</p></noscript>
</section>
</div>
<section class="shell purpose" aria-labelledby="purpose-title"><div class="section-intro"><h2 id="purpose-title">From a blur of activity<br />to something you can read.</h2><p>Keep the original evidence close, whether you’re watching the next call arrive or revisiting yesterday’s run.</p></div><div class="features"><article><span class="feature-symbol" aria-hidden="true">⌁</span><h3>Stay alongside the work.</h3><p>Watch a session as its transcript grows. Open the inspector and keep your place while new events arrive.</p></article><article><span class="feature-symbol" aria-hidden="true">↶</span><h3>Find the moment that matters.</h3><p>Step through events or prompt boundaries. Earlier moments show the evidence available then, without later results leaking in.</p></article><article><span class="feature-symbol" aria-hidden="true">[ ]</span><h3>Build your own understanding.</h3><p>Read inputs, outputs and command references. Mark recurring patterns as Want to understand, Practising or Learned. Ask Mercury for an interpretation when you choose.</p></article></div></section>
<section class="install-wrap" id="install"><div class="shell install"><div><h2>Open a session.<br />Follow your curiosity.</h2><p>Install with Rust 1.88 or newer, then open a session. Apple Silicon and Intel macOS downloads are available on GitHub.</p><a class="text-link" href="https://github.com/rickhallett/linger/releases/latest">Download for macOS ↗</a><br /><a class="text-link" href="/guide/">Read the setup guide <span aria-hidden="true">↗</span></a></div><div class="install-code"><div class="code-caption"><span>Install from crates.io</span><button id="copy-install">Copy commands</button></div><pre id="install-command">cargo install linger --version 0.1.0 --locked
linger</pre><p id="copy-status" role="status">Press Enter in Linger to open the inspector.</p></div></div></section>
<section class="shell questions" aria-labelledby="questions-title"><h2 id="questions-title">Before you jump in.</h2><div><details><summary>Does Linger run my commands?</summary><p>No. Linger reads the transcripts your agents already write. It never executes a captured command, and it does not modify the original transcript.</p></details><details><summary>Does anything leave my machine?</summary><p>Inspection and replay work locally, without a model key. If you explicitly ask Mercury to interpret a call, its selected input and recorded output plus bounded reference notes are sent to your configured provider. This build does not scrub secrets. <a href="/guide/#interpretation">Read the provider details.</a></p></details><details><summary>What works today, and what is next?</summary><p>Live inspection, replay, recorded inputs and outputs, bounded command references and optional Mercury interpretation work in the 0.1.0 release. The pattern library and persistent learning states are also implemented in the 0.1.0 release. Selectable command parts are available with the optional local documentation pack. Inspected calls can be saved with field notes. Episode loops remain future work.</p></details><details><summary>How is Linger related to Zoetrope?</summary><p>Linger is an independent application built on Zoetrope’s transcript discovery, graph and replay foundation. Linger adds the inspector, evidence retention and interpretation layer. Both are MIT-licensed. <a href="https://github.com/furkankly/zoetrope">Explore the upstream project.</a></p></details></div></section>
</main>
<footer class="shell footer"><a class="wordmark" href="/"><span class="logo-bracket" aria-hidden="true">[</span>linger<span class="logo-bracket" aria-hidden="true">]</span></a><p>Let the details sink in.</p><a href="/guide/">Documentation</a><span>MIT licensed</span></footer>
<script is:inline type="application/json" id="demo-data" set:html={JSON.stringify(calls).replace(/</g,'\\u003c')} />
<script>
const data = JSON.parse(document.querySelector('#demo-data')!.textContent!);
let selected = 2;
let view: 'input' | 'output' | 'note' = 'output';
const callButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-call]'));
const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));
const eventButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-event]'));
const text = (id: string, value: string) => {document.getElementById(id)!.textContent = value;};
function render() {
 const call = data[selected];
 callButtons.forEach((b,i)=>{b.classList.toggle('selected',i===selected); b.setAttribute('aria-pressed',String(i===selected));});
 eventButtons.forEach((b,i)=>{b.classList.toggle('current',i===selected); b.setAttribute('aria-pressed',String(i===selected));});
 viewButtons.forEach(b=>{const active=b.dataset.view===view;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});
 text('evidence-title',call.input.split(/[ \n]/)[0]);
 text('exit-status',call.exit===undefined?'No result':`Exit ${call.exit}`);
 document.getElementById('exit-status')!.classList.toggle('failed',call.exit!==0);
 text('evidence-label',view==='note'?'Command reference · authored for this demo':view==='input'?`Recorded input at ${call.time}`:`Recorded at ${call.resultTime ?? 'unknown time'}`);
 text('evidence-text',call[view]);
 text('evidence-foot',view==='note'?'Reference notes explain syntax; they do not execute or verify the command.':view==='input'?'Original recorded command. Displayed here, never executed.':call.exit===0?'The recorded process exit code is 0.': 'The command failed. The recorded error stays visible.');
 text('position',`${String(selected+1).padStart(2,'0')} / ${String(data.length).padStart(2,'0')}`);
 (document.getElementById('previous') as HTMLButtonElement).disabled=selected===0;
 (document.getElementById('next') as HTMLButtonElement).disabled=selected===data.length-1;
}
callButtons.forEach((b,i)=>{b.addEventListener('click',()=>{selected=i;render();}); b.addEventListener('keydown',e=>{if(['ArrowDown','ArrowUp','Home','End'].includes(e.key)){e.preventDefault();selected=e.key==='Home'?0:e.key==='End'?data.length-1:Math.max(0,Math.min(data.length-1,i+(e.key==='ArrowDown'?1:-1)));render();callButtons[selected].focus();}});});
viewButtons.forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view as typeof view;render();}));
eventButtons.forEach((b,i)=>b.addEventListener('click',()=>{selected=i;render();}));
document.getElementById('previous')!.addEventListener('click',()=>{selected=Math.max(0,selected-1);render();});
document.getElementById('next')!.addEventListener('click',()=>{selected=Math.min(data.length-1,selected+1);render();});
document.getElementById('copy-install')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.getElementById('install-command')!.textContent!);text('copy-status','Commands copied.');}catch{text('copy-status','Select and copy the commands above; clipboard access is unavailable.');}});
render();
</script>
</body></html>
